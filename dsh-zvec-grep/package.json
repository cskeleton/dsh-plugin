{
  "name": "dsh-zvec-grep",
  "version": "0.1.0",
  "private": true,
  "description": "zvec-grep 本地语义搜索：复用现有模型和索引，在 DSH 插件页一键开关。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": { "dsh": ">=0.2.1-rc.3" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer"],
      "platform": "web"
    }
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node --test tests/bundle.test.mjs",
    "test:host": "node tests/host-smoke.cjs"
  },
  "devDependencies": { "yaml": "^2.8.1" },
  "packageManager": "pnpm@10.33.2"
}
